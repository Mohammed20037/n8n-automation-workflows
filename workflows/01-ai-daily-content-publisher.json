{
  "name": "AI Daily Content Publisher (LinkedIn + Google Sheets)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "cronExpression", "expression": "0 9 * * 1-5" }
          ]
        }
      },
      "id": "a1111111-1111-4111-8111-111111111111",
      "name": "Every weekday 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-600, 300]
    },
    {
      "parameters": {
        "documentId": { "__rl": true, "value": "YOUR_GOOGLE_SHEET_ID", "mode": "id" },
        "sheetName": { "__rl": true, "value": "Topics", "mode": "name" },
        "filtersUI": {
          "values": [
            { "lookupColumn": "status", "lookupValue": "queued" }
          ]
        },
        "options": {}
      },
      "id": "a2222222-2222-4222-8222-222222222222",
      "name": "Get next queued topic",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [-380, 300]
    },
    {
      "parameters": {
        "modelId": { "__rl": true, "value": "gpt-4o-mini", "mode": "list", "cachedResultName": "gpt-4o-mini" },
        "messages": {
          "values": [
            { "role": "system", "content": "You are a senior content writer. Write one concise, engaging LinkedIn post (max 1200 characters, 2-3 short paragraphs, 3 relevant hashtags, no emojis overload). Return only the post text." },
            { "content": "=Write a LinkedIn post about: {{ $json.topic }}\n\nAudience: {{ $json.audience }}\nTone: {{ $json.tone }}" }
          ]
        },
        "options": { "temperature": 0.7 }
      },
      "id": "a3333333-3333-4333-8333-333333333333",
      "name": "Generate post (OpenAI)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [-160, 300]
    },
    {
      "parameters": {
        "postAs": "person",
        "person": "YOUR_LINKEDIN_PERSON_URN",
        "text": "={{ $json.message.content }}",
        "additionalFields": {}
      },
      "id": "a4444444-4444-4444-8444-444444444444",
      "name": "Publish to LinkedIn",
      "type": "n8n-nodes-base.linkedIn",
      "typeVersion": 1,
      "position": [120, 300]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": { "__rl": true, "value": "YOUR_GOOGLE_SHEET_ID", "mode": "id" },
        "sheetName": { "__rl": true, "value": "Topics", "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "topic": "={{ $('Get next queued topic').item.json.topic }}",
            "status": "published",
            "published_at": "={{ $now.toISO() }}"
          },
          "matchingColumns": ["topic"]
        },
        "options": {}
      },
      "id": "a5555555-5555-4555-8555-555555555555",
      "name": "Mark as published",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [340, 300]
    }
  ],
  "connections": {
    "Every weekday 09:00": { "main": [[{ "node": "Get next queued topic", "type": "main", "index": 0 }]] },
    "Get next queued topic": { "main": [[{ "node": "Generate post (OpenAI)", "type": "main", "index": 0 }]] },
    "Generate post (OpenAI)": { "main": [[{ "node": "Publish to LinkedIn", "type": "main", "index": 0 }]] },
    "Publish to LinkedIn": { "main": [[{ "node": "Mark as published", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
