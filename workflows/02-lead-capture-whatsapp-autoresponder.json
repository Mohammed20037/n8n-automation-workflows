{
  "name": "Lead Capture -> AI Qualify -> WhatsApp Auto-Responder",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "new-lead",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "b1111111-1111-4111-8111-111111111111",
      "name": "New lead (Webhook)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-640, 300],
      "webhookId": "b1111111-1111-4111-8111-111111111111"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "f1", "name": "full_name", "value": "={{ $json.body.full_name }}", "type": "string" },
            { "id": "f2", "name": "phone", "value": "={{ $json.body.phone }}", "type": "string" },
            { "id": "f3", "name": "source", "value": "={{ $json.body.source || 'website' }}", "type": "string" },
            { "id": "f4", "name": "message", "value": "={{ $json.body.message }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "b2222222-2222-4222-8222-222222222222",
      "name": "Normalize lead",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-420, 300]
    },
    {
      "parameters": {
        "modelId": { "__rl": true, "value": "gpt-4o-mini", "mode": "list", "cachedResultName": "gpt-4o-mini" },
        "messages": {
          "values": [
            { "role": "system", "content": "You qualify inbound leads. Return STRICT JSON: {\"intent\":\"hot|warm|cold\",\"reply\":\"a short, friendly first WhatsApp reply (max 320 chars) in the lead's language\"}. No prose outside JSON." },
            { "content": "=Lead name: {{ $json.full_name }}\nSource: {{ $json.source }}\nMessage: {{ $json.message }}" }
          ]
        },
        "jsonOutput": true,
        "options": { "temperature": 0.3 }
      },
      "id": "b3333333-3333-4333-8333-333333333333",
      "name": "Qualify + draft reply (OpenAI)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [-200, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "typeValidation": "loose", "version": 2 },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.message.content.intent }}",
              "rightValue": "cold",
              "operator": { "type": "string", "operation": "notEquals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b4444444-4444-4444-8444-444444444444",
      "name": "Worth contacting?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [20, 300]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "phoneNumberId": "YOUR_WABA_PHONE_NUMBER_ID",
        "recipientPhoneNumber": "={{ $('Normalize lead').item.json.phone }}",
        "messageType": "text",
        "textBody": "={{ $json.message.content.reply }}",
        "additionalFields": {}
      },
      "id": "b5555555-5555-4555-8555-555555555555",
      "name": "Send WhatsApp reply",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [260, 200]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": { "__rl": true, "value": "YOUR_CRM_SHEET_ID", "mode": "id" },
        "sheetName": { "__rl": true, "value": "Leads", "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "name": "={{ $('Normalize lead').item.json.full_name }}",
            "phone": "={{ $('Normalize lead').item.json.phone }}",
            "source": "={{ $('Normalize lead').item.json.source }}",
            "intent": "={{ $json.message.content.intent }}",
            "created_at": "={{ $now.toISO() }}"
          }
        },
        "options": {}
      },
      "id": "b6666666-6666-4666-8666-666666666666",
      "name": "Log to CRM sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [260, 400]
    }
  ],
  "connections": {
    "New lead (Webhook)": { "main": [[{ "node": "Normalize lead", "type": "main", "index": 0 }]] },
    "Normalize lead": { "main": [[{ "node": "Qualify + draft reply (OpenAI)", "type": "main", "index": 0 }]] },
    "Qualify + draft reply (OpenAI)": { "main": [[{ "node": "Worth contacting?", "type": "main", "index": 0 }]] },
    "Worth contacting?": {
      "main": [
        [{ "node": "Send WhatsApp reply", "type": "main", "index": 0 }, { "node": "Log to CRM sheet", "type": "main", "index": 0 }],
        [{ "node": "Log to CRM sheet", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
