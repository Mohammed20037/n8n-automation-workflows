{
  "name": "AI Email Auto-Reply Drafter (Gmail)",
  "nodes": [
    {
      "parameters": {
        "pollTimes": { "item": [{ "mode": "everyMinute" }] },
        "simple": true,
        "filters": { "q": "is:unread -in:chats category:primary" },
        "options": {}
      },
      "id": "c1111111-1111-4111-8111-111111111111",
      "name": "New unread email",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [-620, 300]
    },
    {
      "parameters": {
        "modelId": { "__rl": true, "value": "gpt-4o-mini", "mode": "list", "cachedResultName": "gpt-4o-mini" },
        "messages": {
          "values": [
            { "role": "system", "content": "You are an executive assistant. Classify the email and draft a reply. Return STRICT JSON: {\"category\":\"sales|support|recruiting|spam|other\",\"needs_reply\":true|false,\"draft\":\"a polite, concise reply in the sender's language\"}. If spam or no reply needed, set needs_reply=false and draft=\"\"." },
            { "content": "=From: {{ $json.from }}\nSubject: {{ $json.subject }}\n\n{{ $json.snippet }}" }
          ]
        },
        "jsonOutput": true,
        "options": { "temperature": 0.4 }
      },
      "id": "c2222222-2222-4222-8222-222222222222",
      "name": "Classify + draft (OpenAI)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [-380, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "typeValidation": "loose", "version": 2 },
          "conditions": [
            {
              "id": "d1",
              "leftValue": "={{ $json.message.content.needs_reply }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c3333333-3333-4333-8333-333333333333",
      "name": "Needs a reply?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-140, 300]
    },
    {
      "parameters": {
        "resource": "draft",
        "operation": "create",
        "subject": "=Re: {{ $('New unread email').item.json.subject }}",
        "emailType": "text",
        "message": "={{ $json.message.content.draft }}",
        "options": {
          "sendTo": "={{ $('New unread email').item.json.from }}",
          "threadId": "={{ $('New unread email').item.json.threadId }}"
        }
      },
      "id": "c4444444-4444-4444-8444-444444444444",
      "name": "Create Gmail draft",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [120, 200]
    },
    {
      "parameters": {
        "operation": "addLabels",
        "messageId": "={{ $('New unread email').item.json.id }}",
        "labelIds": ["IMPORTANT"]
      },
      "id": "c5555555-5555-4555-8555-555555555555",
      "name": "Flag as needs-review",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [360, 200]
    }
  ],
  "connections": {
    "New unread email": { "main": [[{ "node": "Classify + draft (OpenAI)", "type": "main", "index": 0 }]] },
    "Classify + draft (OpenAI)": { "main": [[{ "node": "Needs a reply?", "type": "main", "index": 0 }]] },
    "Needs a reply?": { "main": [[{ "node": "Create Gmail draft", "type": "main", "index": 0 }], []] },
    "Create Gmail draft": { "main": [[{ "node": "Flag as needs-review", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
